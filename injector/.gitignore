# Build output. Never commit it; the TypeScript side gitignores `dist/` for the
# same reason.
target/

# Generated by `tauri build` / `cargo tauri build`.
src-tauri/gen/

# Release artifacts, produced by `injector/scripts/package.mjs`. The TypeScript
# side gitignores `dist/` for the same reason: both are build output, and a
# committed copy is a copy that drifts from what the pipeline produces.
dist/

# A signed payload staged for packaging. Never committed: it is signed with a
# release key, and the Injector refuses any payload the compiled-in key does not
# verify, so a committed copy could never be used and would only invite someone
# to trust it.
payload/

# A locally built, double-clickable Injector for manual testing: a throwaway
# key, a payload signed with it, a private Cargo target, and the packaged .app.
# Nothing here is a release artifact and nothing here should ever be committed —
# the key signs nothing outside this directory.
.dev-sandbox/
